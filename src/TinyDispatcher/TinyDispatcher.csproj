<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
  </ItemGroup>
  <PropertyGroup>
    <PackagedSourceGeneratorPath>$(MSBuildThisFileDirectory)..\TinyDispatcher.SourceGen\bin\$(Configuration)\netstandard2.0\TinyDispatcher.SourceGen.dll</PackagedSourceGeneratorPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pack generator output into the NuGet under analyzers/ -->
    <None Include="$(PackagedSourceGeneratorPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" Condition="Exists('$(PackagedSourceGeneratorPath)')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyDispatcher.UnitTests" />
    <InternalsVisibleTo Include="TinyDispatcher.IntegrationTests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- NuGet metadata -->
    <PackageId>TinyDispatcher</PackageId>
    <Authors>Jorge Durban Antuñano</Authors>
    <Company>Innerwave</Company>
    <Product>TinyDispatcher</Product>

    <Description>TinyDispatcher is a small, compile-time oriented dispatcher for .NET with generated pipelines, source generation, and built-in OpenTelemetry.</Description>
    <PackageTags>dotnet;dispatcher;mediator;pipeline;sourcegenerator;clean-architecture;opentelemetry;observability</PackageTags>

    <PackageProjectUrl>https://github.com/george2006/TinyDispatcher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/george2006/TinyDispatcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Show README on nuget.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

   </PropertyGroup>

  <PropertyGroup>
    <Version>1.3.0-beta.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Make sure the README is included in the .nupkg root -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyDispatcher 1.3.0-beta.3

      Added
      - Opt-in generated pipeline structure through DispatcherPipelineMaps.Get().
      - Attribute-backed pipeline maps preserving pipeline, context, command, middleware, and policy types.

      Improved
      - Generator diagnostics now point to the relevant source location for duplicate handlers, invalid middleware, pipeline configuration, and referenced-assembly conflicts.

      Fixed
      - Middleware declaration order is preserved within each generated pipeline layer.

      Notes
      - Pipeline-map generation is opt-in and does not affect dispatch when disabled.
      - Reading pipeline maps does not dispatch operations, construct handlers, or execute middleware.
      - 1.2.1 remains the current stable release.
    </PackageReleaseNotes>


  </PropertyGroup>
  
  

</Project>
