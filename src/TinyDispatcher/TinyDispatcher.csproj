<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
  <PropertyGroup>
    <PackagedSourceGeneratorPath>$(MSBuildThisFileDirectory)..\TinyDispatcher.SourceGen\bin\$(Configuration)\netstandard2.0\TinyDispatcher.SourceGen.dll</PackagedSourceGeneratorPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pack generator output into the NuGet under analyzers/ -->
    <None Include="$(PackagedSourceGeneratorPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" Condition="Exists('$(PackagedSourceGeneratorPath)')" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TinyDispatcher.UnitTests" />
    <InternalsVisibleTo Include="TinyDispatcher.IntegrationTests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- NuGet metadata -->
    <PackageId>TinyDispatcher</PackageId>
    <Authors>Jorge Durban Antuñano</Authors>
    <Company>Innerwave</Company>
    <Product>TinyDispatcher</Product>

    <Description>TinyDispatcher is a small, compile-time oriented dispatcher for .NET with pipelines and source generation.</Description>
    <PackageTags>dotnet;dispatcher;mediator;pipeline;sourcegenerator;clean-architecture</PackageTags>

    <PackageProjectUrl>https://github.com/george2006/TinyDispatcher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/george2006/TinyDispatcher</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Show README on nuget.org -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

   </PropertyGroup>

  <PropertyGroup>
    <Version>1.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Make sure the README is included in the .nupkg root -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyDispatcher 1.2.1

      Fixed
      - Generated pipelines now preserve middleware declaration order within the global, policy, and per-command layers.
      - In affected previous versions, including 1.2.0, middleware was extracted in declaration order but later normalized by type name. When declaration and alphabetical order differed, execution order could change.
      - Duplicate middleware registrations continue to keep their first occurrence.

    </PackageReleaseNotes>


  </PropertyGroup>
  
  

</Project>
